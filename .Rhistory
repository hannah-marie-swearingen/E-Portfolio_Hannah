# where R### is the reflectance at wavelength ###...
# Photochemical Reflectance Index (PRI)
calc_PRI <- function(R531, R570){
(R531 - R570) / (R531 + R570)}
# Structure-Independent Pigmentation Index (SIPI)
calc_SIPI <- function(R800, R445, R680){
(R800 - R445) / (R800 - R680)}
# Normalized Difference (Chlorophyll) Index (ND705)
calc_ND705 <- function(R750, R705){
(R750 - R705) / (R750 + R705)}
